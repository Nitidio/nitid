{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nitidio/nitid/studio/api-contract/onnx-meta.schema.json",
  "title": "NitidOnnxMeta",
  "description": "Descriptor that accompanies a nitid ONNX export. It carries what the ONNX graph cannot: class names and the preprocessing contract. `sha256` is optional and only ever added by the REST API (never embedded in the ONNX file, since it would change the hash it describes).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task": {
      "enum": [
        "detect",
        "segment"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id, e.g. nitid1s, or any label for a user ONNX."
    },
    "imgsz": {
      "type": "integer",
      "minimum": 32,
      "maximum": 4096,
      "multipleOf": 32
    },
    "input": {
      "type": "object",
      "properties": {
        "name": {
          "const": "images"
        },
        "shape": {
          "type": "array",
          "description": "Static [1, 3, S, S]; S must equal `imgsz` (checked semantically, not expressible in JSON Schema).",
          "prefixItems": [
            {
              "const": 1
            },
            {
              "const": 3
            },
            {
              "type": "integer",
              "minimum": 32
            },
            {
              "type": "integer",
              "minimum": 32
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "dtype": {
          "const": "float32"
        },
        "range": {
          "const": "0-1"
        },
        "color": {
          "const": "RGB"
        },
        "resize": {
          "const": "squash",
          "description": "Resize((S, S)) without preserving aspect ratio."
        }
      },
      "required": [
        "name",
        "shape",
        "dtype",
        "range",
        "color",
        "resize"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "names": {
      "type": "object",
      "description": "Class names keyed by decimal class id. Free-form map: no additionalProperties:false here.",
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    },
    "topk": {
      "type": "integer",
      "minimum": 1
    },
    "default_iou": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nitid_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "task",
    "model",
    "imgsz",
    "input",
    "outputs",
    "names",
    "topk",
    "default_iou",
    "nitid_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "detect"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "oneOf": [
              {
                "prefixItems": [
                  {
                    "$ref": "#/$defs/labels"
                  },
                  {
                    "$ref": "#/$defs/boxes"
                  },
                  {
                    "$ref": "#/$defs/scores"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              },
              {
                "prefixItems": [
                  {
                    "$ref": "#/$defs/raw_logits"
                  },
                  {
                    "$ref": "#/$defs/raw_boxes"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "segment"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "oneOf": [
              {
                "prefixItems": [
                  {
                    "$ref": "#/$defs/labels"
                  },
                  {
                    "$ref": "#/$defs/boxes"
                  },
                  {
                    "$ref": "#/$defs/scores"
                  },
                  {
                    "$ref": "#/$defs/masks"
                  }
                ],
                "minItems": 4,
                "maxItems": 4
              },
              {
                "prefixItems": [
                  {
                    "$ref": "#/$defs/raw_logits"
                  },
                  {
                    "$ref": "#/$defs/raw_boxes"
                  },
                  {
                    "$ref": "#/$defs/raw_masks"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/labels"
        },
        {
          "$ref": "#/$defs/boxes"
        },
        {
          "$ref": "#/$defs/scores"
        },
        {
          "$ref": "#/$defs/masks"
        },
        {
          "$ref": "#/$defs/raw_logits"
        },
        {
          "$ref": "#/$defs/raw_boxes"
        },
        {
          "$ref": "#/$defs/raw_masks"
        }
      ]
    },
    "labels": {
      "type": "object",
      "properties": {
        "name": {
          "const": "labels"
        },
        "dtype": {
          "const": "int64"
        }
      },
      "required": [
        "name",
        "dtype"
      ],
      "additionalProperties": false
    },
    "boxes": {
      "type": "object",
      "properties": {
        "name": {
          "const": "boxes"
        },
        "dtype": {
          "const": "float32"
        },
        "format": {
          "const": "xyxy_input_px"
        }
      },
      "required": [
        "name",
        "dtype",
        "format"
      ],
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "properties": {
        "name": {
          "const": "scores"
        },
        "dtype": {
          "const": "float32"
        }
      },
      "required": [
        "name",
        "dtype"
      ],
      "additionalProperties": false
    },
    "masks": {
      "type": "object",
      "properties": {
        "name": {
          "const": "masks"
        },
        "dtype": {
          "const": "float32"
        },
        "stride": {
          "const": 4
        }
      },
      "required": [
        "name",
        "dtype",
        "stride"
      ],
      "additionalProperties": false
    },
    "raw_logits": {
      "type": "object",
      "properties": {
        "name": {
          "const": "pred_logits"
        },
        "dtype": {
          "const": "float32"
        }
      },
      "required": [
        "name",
        "dtype"
      ],
      "additionalProperties": false
    },
    "raw_boxes": {
      "type": "object",
      "properties": {
        "name": {
          "const": "pred_boxes"
        },
        "dtype": {
          "const": "float32"
        },
        "format": {
          "const": "cxcywh_norm"
        }
      },
      "required": [
        "name",
        "dtype",
        "format"
      ],
      "additionalProperties": false
    },
    "raw_masks": {
      "type": "object",
      "properties": {
        "name": {
          "const": "pred_masks"
        },
        "dtype": {
          "const": "float32"
        },
        "stride": {
          "const": 4
        }
      },
      "required": [
        "name",
        "dtype",
        "stride"
      ],
      "additionalProperties": false
    }
  }
}
